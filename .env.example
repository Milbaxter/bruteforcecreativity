# Optional API keys — the system works without these but they unlock more data sources
# Copy to .env and fill in as needed

# FRED (Federal Reserve Economic Data) — free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Polygon.io — free tier at https://polygon.io/dashboard/signup
POLYGON_API_KEY=

# NewsAPI — free tier at https://newsapi.org/register
NEWS_API_KEY=
